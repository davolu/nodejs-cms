# ── Database (optional) ───────────────────────────────────────────────
# PostgreSQL connection string. On Vercel, add a Neon / Vercel Postgres
# integration and this is set automatically. Locally:
#   postgres://USER:PASSWORD@localhost:5432/nodejs_cms
# The app runs WITHOUT this (in-memory demo data) so it never crashes if unset.
DATABASE_URL=

# ── AI page generation (optional) ─────────────────────────────────────
# Your Anthropic API key enables the "Generate this page with AI" button.
# Without it, the button returns a friendly "AI not configured" message.
ANTHROPIC_API_KEY=

# Model used for generation. Override if your account uses a different one.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Email notifications for form submissions (optional) ───────────────
# If set, new form/newsletter submissions are emailed to you via Resend.
# Submissions are always saved to the database regardless.
RESEND_API_KEY=
NOTIFY_EMAIL=
FROM_EMAIL=

# ── Member auth (Phase 3) ─────────────────────────────────────────────
# Secret used to sign member session cookies. Set a long random string in
# production (e.g. `openssl rand -base64 32`). Falls back to an insecure dev
# value if unset.
AUTH_SECRET=

# ── E-commerce / Stripe (Phase 4) ─────────────────────────────────────
# If set, checkout creates a real Stripe Checkout Session and redirects to it.
# If unset, checkout runs in DEMO mode (records a paid order, no payment taken).
STRIPE_SECRET_KEY=

# ── Media uploads (optional) ──────────────────────────────────────────
# Preferred on Vercel: Vercel Blob. Create a Blob store in the dashboard and connect
# it to the project — Vercel injects BLOB_STORE_ID + VERCEL_OIDC_TOKEN automatically
# (OIDC), so uploads work with no manual config. BLOB_READ_WRITE_TOKEN is only needed
# for a static token (e.g. running outside Vercel).
BLOB_READ_WRITE_TOKEN=
BLOB_FOLDER=
# Alternative: Cloudinary (works anywhere, CDN-backed).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
# Self-hosted local disk: custom dir + the public base URL it's served at.
# If none of the above are set, files save to ./public/uploads (self-host) or
# inline as data URLs (<=2MB) as a last resort.
UPLOAD_DIR=
UPLOAD_URL_BASE=

# ── Connectors (OAuth apps — optional, add only for the ones you connect) ─────
# The Connectors admin shows the exact redirect URI to register with each provider.
# Google (Gmail, Drive, Calendar, Sheets share one OAuth client):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# ── API-key connectors (Connectors admin shows these when you click "Add API key") ─
MAILCHIMP_API_KEY=
# STRIPE_SECRET_KEY is already listed above (used for checkout + the Stripe connector)

# ── More API-key connectors (add only the ones you use) ──
SENDGRID_API_KEY=
RESEND_API_KEY_ALT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
OPENAI_API_KEY=
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTHOG_API_KEY=
