# ── Database (optional) ───────────────────────────────────────────────
# PostgreSQL connection string. On Vercel, add a Neon / Vercel Postgres
# integration and this is set automatically. Locally:
#   postgres://USER:PASSWORD@localhost:5432/nodejs_cms
# The app runs WITHOUT this (in-memory demo data) so it never crashes if unset.
DATABASE_URL=

# ── AI page generation (optional) ─────────────────────────────────────
# Your Anthropic API key enables the "Generate this page with AI" button.
# Without it, the button returns a friendly "AI not configured" message.
ANTHROPIC_API_KEY=

# Model used for generation. Override if your account uses a different one.
ANTHROPIC_MODEL=claude-sonnet-4-6
