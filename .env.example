# PostgreSQL connection string.
# On Vercel: add a Vercel Postgres / Neon integration and this is set automatically.
# Locally: postgres://USER:PASSWORD@localhost:5432/nodejs_cms
#
# NOTE: The app runs WITHOUT this set — it falls back to in-memory seed data
# so the demo works out of the box. Set it to persist data in real Postgres.
DATABASE_URL=
